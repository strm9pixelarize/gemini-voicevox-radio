# /DATA/AppData/azuracast_program/.env にコピーして使う (Git 管理外)
# 外部 VOICEVOX Engine (合成のみ外部サーバーに委託)
# 正規ルートはポート80: jikantoki-sub (192.168.104.3) の Apache が
# ServerName voicevox.enoki.local のバーチャルホストで Engine (localhost:50021)
# へリバースプロキシしている (2026-11-17 実機確認)。
# 直接の :50021 は RTX フィルター+宛先 ufw の二段で遮断されるため使わない。
# 前提: 接続元で voicevox.enoki.local -> 192.168.104.3 の名前解決ができること
# (ホストは /etc/hosts、コンテナは compose の extra_hosts で寄せる)
VOICEVOX_HOST=http://voicevox.enoki.local
# Muse API (Phase 2 で使用)
ANTHROPIC_API_KEY=
